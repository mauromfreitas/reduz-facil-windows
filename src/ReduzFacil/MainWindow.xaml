<Window x:Class="ReduzFacil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reduz Fácil" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource Text}" Icon="/Assets/app.ico"
        AllowDrop="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Background="{DynamicResource Sidebar}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24" Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reduz Fácil" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="para Windows" Foreground="#8FC9B5" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <RadioButton x:Name="NavReduzir" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="OnNav">
                    <TextBlock Text="⬇  Reduzir" />
                </RadioButton>
                <RadioButton x:Name="NavPeso" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNav">
                    <TextBlock Text="🔍  Onde está o peso" />
                </RadioButton>
                <RadioButton x:Name="NavFerramentas" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNav">
                    <TextBlock Text="🧰  Ferramentas de PDF" />
                </RadioButton>
                <RadioButton x:Name="NavHistorico" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNav">
                    <TextBlock Text="🕘  Histórico" />
                </RadioButton>
                <RadioButton x:Name="NavConfig" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav" Checked="OnNav">
                    <TextBlock Text="⚙  Configurações" />
                </RadioButton>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <TextBlock x:Name="WatchBadge" Foreground="#8FC9B5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock x:Name="SavedTotal" Foreground="White" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" Foreground="#5E8C7C" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <DockPanel Grid.Column="1">
            <!-- Faixa de atualização -->
            <Border x:Name="UpdateBar" DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" Padding="28,10" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdNotesBtn" Content="Ver novidades" Style="{StaticResource Small}" Click="OnUpdateNotes" />
                        <Button x:Name="UpdLaterBtn" Content="Depois" Style="{StaticResource Small}" Click="OnUpdateLater" />
                        <Button x:Name="UpdNowBtn" Content="Atualizar" Style="{StaticResource Primary}" Padding="14,5" Margin="8,0,0,0" Click="OnUpdateNow" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdText" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                        <ProgressBar x:Name="UpdProgress" Maximum="1" Margin="0,4,16,0" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <ContentControl x:Name="Host" />
                <!-- Aviso rápido -->
                <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Background="{DynamicResource Toast}" CornerRadius="10" Padding="16,10" Visibility="Collapsed">
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastText}" TextWrapping="Wrap" MaxWidth="560" />
                </Border>
                <!-- Arrastando arquivos por cima da janela -->
                <Border x:Name="DropOverlay" Background="#CC0E9F6E" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="Solte para reduzir" Foreground="White" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
