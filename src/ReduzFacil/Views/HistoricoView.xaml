<UserControl x:Class="ReduzFacil.Views.HistoricoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Histórico" Style="{StaticResource H1}" />
            <TextBlock Text="Os últimos 1.000 arquivos reduzidos. O total economizado conta desde a primeira vez." Style="{StaticResource MutedText}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Espaço economizado" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TotSaved" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentDark}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="Arquivos processados" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TotFiles" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Redução média" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TotPct" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <ListBox Grid.Row="2" x:Name="HistList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,8" ToolTip="{Binding Tooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{Binding Tint}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Emoji" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding When}" Foreground="{DynamicResource Muted}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="150">
                                <TextBlock Text="{Binding Sizes}" HorizontalAlignment="Right" FontSize="13" />
                                <TextBlock Text="{Binding Saving}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource AccentDark}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Abrir" Style="{StaticResource Small}" Tag="{Binding}" Click="OnOpen" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                                <Button Content="Pasta" Style="{StaticResource Small}" Tag="{Binding}" Click="OnFolder" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Limpar histórico" Click="OnClear" Margin="0" ToolTip="Apaga a lista (o total economizado continua)" />
        </StackPanel>
    </Grid>
</UserControl>
