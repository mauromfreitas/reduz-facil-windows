<UserControl x:Class="ReduzFacil.Views.PesoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Onde está o peso" Style="{StaticResource H1}" />
            <TextBlock Text="Procura numa pasta ou disco as fotos, vídeos, áudios e PDFs que mais ocupam espaço e mostra quanto daria para economizar. Nada é alterado só por procurar."
                       Style="{StaticResource MutedText}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="18,14">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="ScanBtn" Content="Procurar" Style="{StaticResource Primary}" Click="OnScan" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Escolher pasta…" Click="OnPick" Margin="8,0,0,0" />
                    <TextBox x:Name="FolderText" FontSize="14" />
                </DockPanel>
                <WrapPanel x:Name="QuickPanel" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Só arquivos a partir de" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="MinText" Width="60" Margin="8,0" />
                    <TextBlock Text="MB · estimativa no nível escolhido em Reduzir" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="Status" Style="{StaticResource MutedText}" Margin="2,0,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

        <ListBox Grid.Row="3" x:Name="HitList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10,8" ToolTip="{Binding Hit.Path}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{Binding Tint}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Emoji" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding State}" Foreground="{StaticResource AccentDark}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="4" MinWidth="170" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" FontSize="13">
                                    <Run Text="{Binding Size, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Estimate, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Saving}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentDark}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelText" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Todos" Click="OnAll" />
                <Button Content="Nenhum" Click="OnNone" />
                <Button x:Name="ReduceBtn" Content="Reduzir selecionados" Style="{StaticResource Primary}" Click="OnReduce" />
                <Button x:Name="RecycleBtn" Content="Originais para a Lixeira…" Click="OnRecycle" Margin="0"
                        ToolTip="Depois de reduzir, libera o espaço mandando os originais para a Lixeira (dá para restaurar)." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
