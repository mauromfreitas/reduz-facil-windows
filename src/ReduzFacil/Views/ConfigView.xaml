<UserControl x:Class="ReduzFacil.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource H1}" />
            <TextBlock Text="Tudo fica salvo em ReduzFacil-dados, ao lado do .exe." Style="{StaticResource MutedText}" Margin="0,0,0,14" />

            <!-- Saída -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Onde salvar os arquivos reduzidos" Style="{StaticResource H2}" />
                    <RadioButton x:Name="OutNext" GroupName="out" Content="Ao lado do original" Margin="0,2" Checked="OnOutput" />
                    <RadioButton x:Name="OutFolder" GroupName="out" Content="Numa pasta escolhida (recria as subpastas)" Margin="0,2" Checked="OnOutput" />
                    <DockPanel Margin="22,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource Small}" Click="OnPickOutput" />
                        <TextBox x:Name="OutFolderText" LostFocus="OnOutput" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Final do nome" Style="{StaticResource FieldLabel}" Width="120" />
                        <TextBox x:Name="SuffixText" Width="140" LostFocus="OnOutput" />
                        <TextBlock x:Name="SuffixExample" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <CheckBox x:Name="KeepDatesCheck" Content="O arquivo novo fica com a data do original (fotos continuam em ordem)" Margin="0,10,0,0" Checked="OnOutput" Unchecked="OnOutput" />
                    <TextBlock Text="O original nunca é apagado nem substituído." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Desempenho -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Desempenho" Style="{StaticResource H2}" />
                    <DockPanel>
                        <TextBlock Text="Placa de vídeo" Style="{StaticResource FieldLabel}" />
                        <Button DockPanel.Dock="Right" Content="Detectar de novo" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnRedetect" />
                        <TextBlock x:Name="HwText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Vídeos ao mesmo tempo" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="VideosBox" MinWidth="80" SelectionChanged="OnPerf" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Fotos, PDFs e áudios ao mesmo tempo" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="OthersBox" MinWidth="80" SelectionChanged="OnPerf" />
                    </StackPanel>
                    <TextBlock Text="Os motores rodam com prioridade baixa: dá para continuar usando o PC enquanto comprime." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Windows -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Windows" Style="{StaticResource H2}" />
                    <CheckBox x:Name="ShellCheck" Content="Botão direito do Explorer: &quot;Reduzir com Reduz Fácil&quot; (com os atalhos WhatsApp, e-mail…)" Checked="OnWindows" Unchecked="OnWindows" />
                    <TextBlock Text="No Windows 11 ele aparece em &quot;Mostrar mais opções&quot;. Fica só no seu usuário e some quando desligar." Style="{StaticResource MutedText}" Margin="22,0,0,6" />
                    <CheckBox x:Name="StartupCheck" Content="Iniciar com o Windows (perto do relógio, para a pasta vigiada)" Checked="OnWindows" Unchecked="OnWindows" />
                    <CheckBox x:Name="TrayCheck" Content="Ao fechar a janela, continuar perto do relógio se a pasta vigiada estiver ligada" Checked="OnWindows" Unchecked="OnWindows" />
                    <CheckBox x:Name="NotifyCheck" Content="Avisar quando terminar (se a janela estiver em segundo plano)" Checked="OnWindows" Unchecked="OnWindows" />
                </StackPanel>
            </Border>

            <!-- Pasta vigiada -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Pasta vigiada" Style="{StaticResource H2}" />
                    <TextBlock Text="Tudo o que chegar nessa pasta (fotos do WhatsApp, downloads, cópias do celular) é reduzido sozinho."
                               Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <CheckBox x:Name="WatchCheck" Content="Ligada" Checked="OnWatch" Unchecked="OnWatch" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Pasta" Style="{StaticResource FieldLabel}" Width="120" />
                        <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource Small}" Click="OnPickWatch" />
                        <TextBox x:Name="WatchFolderText" LostFocus="OnWatch" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Como reduzir" Style="{StaticResource FieldLabel}" Width="120" />
                        <ComboBox x:Name="WatchProfileBox" MinWidth="260" SelectionChanged="OnWatch" />
                    </StackPanel>
                    <CheckBox x:Name="WatchSubCheck" Content="Incluir subpastas" Margin="0,8,0,0" Checked="OnWatch" Unchecked="OnWatch" />
                    <TextBlock x:Name="WatchStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Perfis -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Meus perfis" Style="{StaticResource H2}" />
                    <TextBlock Text="Crie em Reduzir → Mais opções → Salvar como perfil." Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <StackPanel x:Name="ProfilesPanel" />
                </StackPanel>
            </Border>

            <!-- Sobre -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Sobre" Style="{StaticResource H2}" />
                    <TextBlock x:Name="AboutText" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Abrir a pasta de dados" Style="{StaticResource Small}" Margin="0,0,8,0" Click="OnOpenData" />
                        <Button Content="Abrir o registro (log)" Style="{StaticResource Small}" Margin="0" Click="OnOpenLog" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
