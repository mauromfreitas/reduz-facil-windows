<UserControl x:Class="ReduzFacil.Views.FerramentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Ferramentas de PDF" Style="{StaticResource H1}" />
            <TextBlock Text="Juntar fotos num PDF e separar páginas. Arraste os arquivos para esta tela ou use os botões." Style="{StaticResource MutedText}" Margin="0,0,0,14" />

            <!-- Juntar fotos -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Juntar fotos num PDF" Style="{StaticResource H2}" />
                    <TextBlock Text="Ótimo para documentos fotografados com o celular (RG, comprovantes, contratos). O PDF já sai reduzido." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="PhotoList" Height="200" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Field}"
                                 Foreground="{DynamicResource Text}" SelectionMode="Extended" AllowDrop="True" Drop="OnPhotoDrop" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="160">
                            <Button Content="Adicionar fotos…" Style="{StaticResource Small}" Margin="0,0,0,6" Click="OnAddPhotos" />
                            <Button Content="▲ Subir" Style="{StaticResource Small}" Margin="0,0,0,6" Click="OnUp" />
                            <Button Content="▼ Descer" Style="{StaticResource Small}" Margin="0,0,0,6" Click="OnDown" />
                            <Button Content="Ordenar por nome" Style="{StaticResource Small}" Margin="0,0,0,6" Click="OnSortName" />
                            <Button Content="Ordenar por data" Style="{StaticResource Small}" Margin="0,0,0,6" Click="OnSortDate" />
                            <Button Content="Tirar da lista" Style="{StaticResource DangerSmall}" Margin="0" Click="OnRemovePhotos" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Página:" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{DynamicResource Muted}" />
                        <RadioButton x:Name="PageA4" Style="{StaticResource Chip}" GroupName="pg" Content="A4 (para imprimir)" IsChecked="True" />
                        <RadioButton x:Name="PagePhoto" Style="{StaticResource Chip}" GroupName="pg" Content="Do tamanho da foto" />
                        <TextBlock Text="Qualidade:" VerticalAlignment="Center" Margin="12,0,10,8" Foreground="{DynamicResource Muted}" />
                        <RadioButton x:Name="PdfMax" Style="{StaticResource Chip}" GroupName="pq" Content="Máxima" />
                        <RadioButton x:Name="PdfEq" Style="{StaticResource Chip}" GroupName="pq" Content="Equilibrada" IsChecked="True" />
                        <RadioButton x:Name="PdfMin" Style="{StaticResource Chip}" GroupName="pq" Content="Menor tamanho" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="JoinBtn" Content="Criar PDF…" Style="{StaticResource Primary}" Click="OnJoin" />
                        <TextBlock x:Name="JoinStatus" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <ProgressBar x:Name="JoinProgress" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Separar páginas -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Separar páginas de um PDF" Style="{StaticResource H2}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Escolher PDF…" Style="{StaticResource Small}" Click="OnPickPdf" />
                        <TextBlock x:Name="PdfName" VerticalAlignment="Center" Text="Nenhum PDF escolhido (ou arraste um para cá)." Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <RadioButton x:Name="SplitEach" Content="Uma página por arquivo" Margin="0,10,0,4" GroupName="sp" IsChecked="True" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SplitRanges" Content="Só estas páginas:" GroupName="sp" VerticalAlignment="Center" />
                        <TextBox x:Name="RangesText" Width="200" Margin="10,0,0,0" GotFocus="OnRangesFocus" />
                        <TextBlock Text="ex.: 1-3, 5, 8-   (cada grupo vira um PDF)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SplitBtn" Content="Separar" Style="{StaticResource Primary}" Click="OnSplit" />
                        <Button x:Name="SplitFolderBtn" Content="Abrir a pasta" Click="OnSplitFolder" Visibility="Collapsed" />
                        <TextBlock x:Name="SplitStatus" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
